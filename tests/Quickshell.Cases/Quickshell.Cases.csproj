<Project Sdk="Microsoft.NET.Sdk">

  <!-- QS147. The driving half of the UI cases in ..\..\cases.

       One package reference and no path into the engine's source, which is what the sibling
       project's own adoption sample says an adopter is. It references Quickshell.App through
       nothing either: the application under test must not be on the driving project's reference
       graph, or a case would be asserting against types it was compiled with rather than against
       what a user launches.

       It lives under tests\ so run-tests.cmd runs it with everything else - the point of the whole
       exercise is that a UI claim is part of the suite rather than something somebody does by hand
       on a desk they happen to be sitting at. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Quickshell.Cases</RootNamespace>

    <!-- For System.Windows.Automation in ExplorerDropRun alone, whose drop lands in another
         process's window — a gesture no case can spell yet (winwright WW530). Not Quickshell.App:
         the rule above still holds. -->
    <UseWPF>true</UseWPF>

    <!-- LibraryImport's generated marshalling, for the same file's SendInput. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- No RuntimeIdentifier, deliberately. It would put the executable under a win-x64 segment,
         and run-tests.cmd looks for tests\<Name>\bin\<Config>\net10.0-windows\<Name>.exe — so a RID
         here reads as "no test application" and counts as a failed assembly. The application under
         test sets one; this project only launches it by the path winwright.json spells. -->
  </PropertyGroup>

  <!-- 1.0.0, from nuget.org (QS176). alpha.3 came from a machine's package cache and nowhere a clean
       clone can reach, and it predates `press` spelling a chord (WW317) — which is why the case files
       opened the palette, the import and the tabs by flag rather than by the chord a user presses.
       1.0.1 for a fixture's own staged files (WW509) and working directory (WW508), QS217.
       1.0.2 for a fixture that reaches a server (WW522), a staged file filled with where it landed
       (WW527), a tab found by its item status (WW523), and a red case that collapses what it
       expanded (WW525): QS273 and QS278.
       1.1.0 for a survivor that names the case that launched it (WW531, from QS298), a drag that
       drops onto another window (WW530), and one run at a time on the guest desk (WW534, from
       QS302): QS303. -->
  <ItemGroup>
    <PackageReference Include="Winwright" Version="1.1.0" />
  </ItemGroup>

</Project>
