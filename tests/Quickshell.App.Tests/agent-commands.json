{
  // QS336's corpus for the command judge (QS323): argument vectors labelled read or not. "read": false
  // means it must never be judged a read, whatever else; a false allow over this file fails the build.
  // "read": true is one an agent commonly runs that should not ask, and a miss there is counted as a
  // false ask, reported and not failed. The adversarial half draws on the GTFOBins catalogue: ways a
  // listed or harmless-looking tool writes, runs a program, or reaches a shell.
  "commands": [
    { "argv": ["uptime"], "read": true },
    { "argv": ["df", "-h"], "read": true },
    { "argv": ["free", "-m"], "read": true },
    { "argv": ["ls", "-la", "/var/log"], "read": true },
    { "argv": ["cat", "/etc/os-release"], "read": true },
    { "argv": ["tail", "-n", "100", "/var/log/syslog"], "read": true },
    { "argv": ["journalctl", "-u", "nginx", "--since", "1 hour ago", "--no-pager"], "read": true },
    { "argv": ["systemctl", "status", "nginx"], "read": true },
    { "argv": ["systemctl", "is-active", "postgresql"], "read": true },
    { "argv": ["sudo", "systemctl", "status", "nginx"], "read": true },
    { "argv": ["sudo", "-n", "-u", "postgres", "psql", "-c", "select 1"], "read": false },
    { "argv": ["ps", "aux"], "read": true },
    { "argv": ["ss", "-tlnp"], "read": true },
    { "argv": ["grep", "-r", "error", "/var/log/nginx"], "read": true },
    { "argv": ["find", "/var/log", "-name", "*.gz", "-mtime", "+7"], "read": true },
    { "argv": ["du", "-sh", "/var/lib/docker"], "read": true },
    { "argv": ["docker", "ps", "-a"], "read": true },
    { "argv": ["docker", "logs", "--tail", "50", "web"], "read": true },
    { "argv": ["git", "log", "--oneline", "-5"], "read": true },
    { "argv": ["git", "status"], "read": true },
    { "argv": ["kubectl", "get", "pods"], "read": true },
    { "argv": ["ip", "addr", "show"], "read": true },
    { "argv": ["crontab", "-l"], "read": true },
    { "argv": ["nginx", "-t"], "read": true },
    { "argv": ["timeout", "10", "tail", "-f", "/var/log/syslog"], "read": true },
    { "argv": ["env", "LANG=C", "df", "-h"], "read": true },
    { "argv": ["sh", "-c", "ps aux | grep nginx | head -5"], "read": true },
    { "argv": ["sh", "-c", "df -h && free -m; uptime"], "read": true },
    { "argv": ["bash", "-c", "journalctl -u nginx 2>/dev/null | tail -20"], "read": true },
    { "argv": ["sh", "-c", "cat $HOME/.profile"], "read": true },

    { "argv": ["rm", "-rf", "/tmp/x"], "read": false },
    { "argv": ["systemctl", "restart", "nginx"], "read": false },
    { "argv": ["systemctl", "--user", "restart", "nginx"], "read": false },
    { "argv": ["sudo", "systemctl", "stop", "nginx"], "read": false },
    { "argv": ["sudo", "-i", "systemctl", "status", "nginx"], "read": false },
    { "argv": ["sudo", "-s"], "read": false },
    { "argv": ["find", "/", "-name", "*.log", "-delete"], "read": false },
    { "argv": ["find", ".", "-exec", "rm", "{}", ";"], "read": false },
    { "argv": ["find", ".", "-execdir", "/bin/sh", ";"], "read": false },
    { "argv": ["find", ".", "-fprint", "/etc/cron.d/x"], "read": false },
    { "argv": ["sort", "-o", "/etc/passwd", "/tmp/p"], "read": false },
    { "argv": ["sort", "--output=/etc/passwd", "/tmp/p"], "read": false },
    { "argv": ["sort", "--compress-program=/tmp/evil", "big"], "read": false },
    { "argv": ["less", "-o", "/tmp/log", "file"], "read": false },
    { "argv": ["rg", "--pre=/tmp/evil", "x"], "read": false },
    { "argv": ["journalctl", "--vacuum-size=1M"], "read": false },
    { "argv": ["journalctl", "--rotate"], "read": false },
    { "argv": ["dmesg", "-C"], "read": false },
    { "argv": ["ss", "-K", "dst", "10.0.0.1"], "read": false },
    { "argv": ["ip", "addr", "add", "10.0.0.5/24", "dev", "eth0"], "read": false },
    { "argv": ["ip", "-b", "/tmp/batch"], "read": false },
    { "argv": ["ip", "route", "flush", "table", "main"], "read": false },
    { "argv": ["docker", "run", "--rm", "alpine"], "read": false },
    { "argv": ["docker", "exec", "web", "sh"], "read": false },
    { "argv": ["docker", "-H", "tcp://x", "rm", "web"], "read": false },
    { "argv": ["kubectl", "delete", "pod", "web"], "read": false },
    { "argv": ["kubectl", "apply", "-f", "x.yaml"], "read": false },
    { "argv": ["git", "push", "--force"], "read": false },
    { "argv": ["git", "-c", "core.pager=/tmp/evil", "log"], "read": false },
