    { "argv": ["git", "diff", "-o", "/etc/motd"], "read": false },
    { "argv": ["crontab", "-e"], "read": false },
    { "argv": ["crontab", "/tmp/cron"], "read": false },
    { "argv": ["crontab", "-r"], "read": false },
    { "argv": ["date", "-s", "2020-01-01"], "read": false },
    { "argv": ["hostname", "evil"], "read": false },
    { "argv": ["sed", "-i", "s/a/b/", "/etc/hosts"], "read": false },
    { "argv": ["sed", "-n", "1p", "/etc/hosts"], "read": false },
    { "argv": ["awk", "BEGIN {system(\"/bin/sh\")}"], "read": false },
    { "argv": ["tee", "/etc/hosts"], "read": false },
    { "argv": ["python3", "-c", "print(1)"], "read": false },
    { "argv": ["perl", "-e", "exec \"/bin/sh\";"], "read": false },
    { "argv": ["xargs", "rm"], "read": false },
    { "argv": ["nohup", "uptime"], "read": false },
    { "argv": ["vi", "/etc/hosts"], "read": false },
    { "argv": ["busybox", "sh"], "read": false },
    { "argv": ["env", "PATH=/tmp", "ls"], "read": false },
    { "argv": ["env", "LD_PRELOAD=/tmp/x.so", "ls"], "read": false },
    { "argv": ["env", "BASH_ENV=/tmp/x", "ls"], "read": false },
    { "argv": ["env", "-i", "ls"], "read": false },
    { "argv": ["timeout", "-s", "KILL", "5", "ls"], "read": false },
    { "argv": ["nice", "-20", "ls"], "read": false },
    { "argv": ["/usr/bin/rm", "-f", "x"], "read": false },
    { "argv": ["chmod", "777", "/etc/shadow"], "read": false },
    { "argv": ["curl", "-o", "/tmp/x", "http://x"], "read": false },
    { "argv": ["wget", "http://x"], "read": false },
    { "argv": ["dd", "if=/dev/zero", "of=/dev/sda"], "read": false },
    { "argv": ["mv", "a", "b"], "read": false },
    { "argv": ["cp", "a", "b"], "read": false },
    { "argv": ["touch", "x"], "read": false },
    { "argv": ["mkdir", "x"], "read": false },
    { "argv": ["kill", "1"], "read": false },
    { "argv": ["pkill", "nginx"], "read": false },
    { "argv": ["reboot"], "read": false },
    { "argv": ["apt", "install", "x"], "read": false },
    { "argv": ["apt-get", "update"], "read": false },
    { "argv": ["dpkg", "-i", "x.deb"], "read": false },
    { "argv": ["rpm", "-e", "x"], "read": false },
    { "argv": ["nginx", "-s", "reload"], "read": false },
    { "argv": ["mount", "/dev/sdb1", "/mnt"], "read": false },
    { "argv": ["sh", "-c", "ls; rm -rf /tmp/x"], "read": false },
    { "argv": ["sh", "-c", "cat x > /etc/hosts"], "read": false },
    { "argv": ["sh", "-c", "cat x >> /etc/hosts"], "read": false },
    { "argv": ["sh", "-c", "ls $(rm -rf /)"], "read": false },
    { "argv": ["sh", "-c", "ls `rm -rf /`"], "read": false },
    { "argv": ["sh", "-c", "echo \"$(id)\""], "read": false },
    { "argv": ["sh", "-c", "X=1 ls"], "read": false },
    { "argv": ["sh", "-c", "$CMD"], "read": false },
    { "argv": ["sh", "-c", "(ls)"], "read": false },
    { "argv": ["sh", "-c", "{ ls; }"], "read": false },
    { "argv": ["sh", "-c", "ls &"], "read": false },
    { "argv": ["sh", "-c", "cat <<EOF\nx\nEOF"], "read": false },
    { "argv": ["sh", "-c", "find . $X"], "read": false },
    { "argv": ["sh", "-c", "find . *"], "read": false },
    { "argv": ["sh", "-c", "ls | sh"], "read": false },
    { "argv": ["sh", "-c", "ls | xargs rm"], "read": false },
    { "argv": ["sh", "-c", "echo cm0gLXJmIC8K | base64 -d | sh"], "read": false },
    { "argv": ["sh", "-c", "ls\nrm x"], "read": false },
    { "argv": ["sh", "-c", "ls # ; rm x"], "read": false },
    { "argv": ["sh", "-c", "ls", "extra"], "read": false },
    { "argv": ["sh", "-c", "ls 2>/dev/null>x"], "read": false },
    { "argv": ["sh", "x.sh"], "read": false },
    { "argv": ["bash", "-c", "ls |& tee x"], "read": false },
    { "argv": ["sh", "-c", "sudo -s"], "read": false },
    { "argv": ["sh", "-c", "eval ls"], "read": false },
    { "argv": ["sh", "-c", "ls\\;rm"], "read": false },
    { "argv": ["sh", "-c", "~/bin/x"], "read": false }
  ]
