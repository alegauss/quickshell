<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Quickshell.Architecture.Tests</RootNamespace>

    <!-- WPF is referenced by the tests and by nothing else yet: the Fluent guard below asserts
         against the real PresentationFramework this tree targets, which is the only way to
         answer "is Fluent reachable here" with a run instead of with a version number. -->
    <UseWPF>true</UseWPF>
    <!-- WPF0001: ThemeMode is still marked [Experimental] in the SDK and is the supported way in,
         the same suppression claude-tray and freewilly carry. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The seam is asserted about by reflection as well as by reading files, so the assembly
         holding it is referenced here. This is a test project: it is above nothing. -->
    <ProjectReference Include="..\..\src\Quickshell.Transport\Quickshell.Transport.csproj" />
  </ItemGroup>

</Project>
