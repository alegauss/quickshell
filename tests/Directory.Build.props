<Project>

  <!-- Inherits the repository's own gates, then adds what only a test project needs. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputType>Exe</OutputType>

    <!-- xunit.v3 ships two runners. Its own console runner is what an assembly launched directly
         gets, and it does not speak the protocol `dotnet test` uses: handed those arguments it
         discovers nothing, reports "zero tests ran" and exits 5 on a suite that passes. This
         switches both to the Microsoft.Testing.Platform runner, so the one command and the
         assembly agree about what is in the tree. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <!-- QS99: every test assembly refuses to run when it is older than the source it is built from,
       so a failed build cannot be followed by a green run of the binary it left behind. The project's
       own path is written into the assembly for the check to start from. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Freshness.cs" Link="Freshness.cs" />
    <AssemblyMetadata Include="QuickshellTestProject" Value="$(MSBuildProjectFullPath)" />
  </ItemGroup>

</Project>
