<Project Sdk="Microsoft.NET.Sdk">

  <!-- The channel's own tests. They start real processes and read real bytes, and they reference
       nothing above the transport layer: a shell that will not close is a transport defect, and
       this project is where it has to be reported. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Quickshell.Transport.Tests</RootNamespace>
    <!-- FakePageant is a window and a file mapping, declared through LibraryImport, whose generated
         marshalling is unsafe by construction - the same reason the transport itself allows it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quickshell.Transport\Quickshell.Transport.csproj" />
  </ItemGroup>

</Project>
