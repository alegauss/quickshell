<Project>

  <!-- Every setting here is a gate the roadmap asks for, applied to every project so that
       none of them can be turned off in one .csproj without the diff showing it. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>

    <!-- x64 only. There is no ARM or x86 build, and no AnyCPU that would pretend otherwise. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- One output tree per configuration, not two.
         The solution pins every project to x64 while a bare `dotnet build <csproj>` resolves no
         platform at all, so without this the same project writes bin\x64\Debug\ from one command
         and bin\Debug\ from the other - and running a binary from the tree the last build did not
         touch is how a change that was already made gets debugged for an hour.
         It is also what makes `dotnet test` work: the platform segment is not in the path its MTP
         integration launches the test app from, so under x64 it found nothing, reported "zero
         tests ran" and exited 5 on a suite that passes. There is only one platform here, so the
         segment carried no information to lose. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>

    <!-- The allocation-sensitive rules are on from commit one: the parse path will later
         assert that it allocates nothing, and a rule turned on after the code exists is a
         rule nobody turns on. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisModePerformance>All</AnalysisModePerformance>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>

    <!-- What a release is called: the archive carries it in its name, and the list of installed apps
         shows it. One number for every assembly, so a release is one edit here and not one per
         project. -->
    <Version>0.1.0</Version>

    <!-- Off, and QS154 is why: with it on, this client cannot show a text box.

         WPF builds a CultureInfo in two places a terminal cannot avoid. The font cache asks for
         "en" when a typeface is named, and the text input stack asks for the user's own keyboard
         layout the moment a TextBox draws a caret. In invariant mode both throw, so the paste
         preview killed the client on open and the find bar killed it again for a different reason.
         Neither is a mistake a rule could have caught: a client with a settings surface and a
         search box has text boxes in it.

         It was on for the footprint, and there it buys nothing on Windows - .NET uses the icu.dll
         the operating system already ships. Published: 9,373,193 bytes with it, 9,373,134 without,
         which is the property leaving runtimeconfig.json and nothing else.

         It is not free, and the cost is in the parse path. Replayed corpus, this machine:
         grapheme segmentation falls from 181 to 82 MB/s on cat-log and 83 to 59 on ls-color-r,
         because StringInfo's cluster breaking calls into ICU instead of the runtime's own simple
         one. The whole emulate stage falls about a sixth, 18 to 16 MB/s, which is still far above
         anything a session produces. QS156 is recovering it. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
