{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "Task",
      "Agent",
      "Skill",
      "SlashCommand",
      "Artifact",
      "Workflow",
      "Monitor",
      "BashOutput",
      "KillShell",
      "KillBash",
      "ToolSearch",
      "SendMessage",
      "TaskOutput",
      "TaskStop",
      "ScheduleWakeup",
      "CronCreate",
      "CronList",
      "CronDelete",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "DesignSync",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ShareOnboardingGuide",
      "mcp__plugin_roadkeep_roadkeep",
      "mcp__roadkeep",
      "Bash(python \"${CLAUDE_PROJECT_DIR}/../roadkeep/scripts/roadkeep.py\":*)",
      "Bash(python \"../roadkeep/scripts/roadkeep.py\":*)",
      "Edit(/.claude/skills/roadmap-docs/**)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "acceptEdits"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "roadkeep"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/../roadkeep/scripts/roadkeep.py\" guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|NotebookEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/../roadkeep/scripts/roadkeep.py\" guard",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/../roadkeep/scripts/roadkeep.py\" guard",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
