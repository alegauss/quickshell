<Project Sdk="Microsoft.NET.Sdk">

  <!-- The only assembly allowed to reference all three. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Quickshell.App</RootNamespace>
    <AssemblyName>quickshell</AssemblyName>
    <StartupObject>Quickshell.App.Entry</StartupObject>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Per-Monitor V2 DPI awareness. A glyph rasterised for one scale is wrong at another, and a
         process that lies about its awareness gets a bitmap-stretched window instead. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- QS283: the client's own mark, written by tools\make-icon.py. The executable carries it, and
         with it the Start menu shortcut and the uninstall entry, which point at the executable; a WPF
         window with no icon of its own takes the executable's, so every window does too. -->
    <ApplicationIcon>..\..\assets\quickshell.ico</ApplicationIcon>

    <!-- WPF, which is what QS4 measured and chose: a child HWND per pane reaches a click-to-pixel
         floor of one refresh interval where neither D3DImage nor a SwapChainPanel reaches a single
         frame in any pass. -->
    <UseWPF>true</UseWPF>
    <!-- WPF0001: ThemeMode is still marked [Experimental] in the SDK and is the supported way to
         follow the system theme while running. The sibling clients carry the same suppression. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <!-- The source-generated interop LibraryImport emits is unsafe by construction. Scoped to the
         one file that registers a window class, as it is in the transport. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- QS306: the EFF's large diceware list, 7,776 words, which a generated vault passphrase is drawn
         from. Embedded and read only when one is generated, so a start never touches it. -->
    <EmbeddedResource Include="eff-large-wordlist.txt" LogicalName="Quickshell.App.eff-large-wordlist.txt" />

    <!-- QS336: the commands an agent may run as reads, versioned with the client. -->
    <EmbeddedResource Include="agent-reads.json" LogicalName="Quickshell.App.agent-reads.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- QS315: the PDF of chosen sessions. MIT and managed, the owner's choice on 2026-10-15; loaded
         only when a document is written. Pinned exactly: 6.2.4 is the last MIT release, and 6.5.0 on
         nuget.org declares AGPL-3.0-only, which would bind the whole client. A newer version is a
         licence decision for the owner, not an update. -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="[6.2.4]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quickshell.Terminal\Quickshell.Terminal.csproj" />
    <ProjectReference Include="..\Quickshell.Transport\Quickshell.Transport.csproj" />
    <ProjectReference Include="..\Quickshell.Render\Quickshell.Render.csproj" />
  </ItemGroup>

</Project>
