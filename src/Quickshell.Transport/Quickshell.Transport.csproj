<Project Sdk="Microsoft.NET.Sdk">

  <!-- The protocol seam. It knows nothing about rendering and nothing about the terminal
       buffer, so it carries no ProjectReference either. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Quickshell.Transport</RootNamespace>

    <!-- The source-generated interop LibraryImport emits is unsafe by construction: it pins and
         takes addresses rather than going through the marshalling layer at run time. Scoped to this
         project, and to PtyNative.cs inside it, rather than turned on for the tree. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The protocol library, and the one place in the client it may be named. PrivateAssets is
         what stops it flowing to whatever references this project: without it, Quickshell.App could
         name Renci.SshNet types without ever asking for them, which is exactly the accident QS36
         exists to prevent - arriving through a file nobody edited.

         "compile" and not "all", and the difference is not cosmetic: "all" withholds the runtime
         asset as well, so the library is not copied beside anything that references this project.
         That builds perfectly and then throws FileNotFoundException on the first connection, which
         is how it was found here. Hiding the types is the goal; withholding the DLL is a bug. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" PrivateAssets="compile" />

    <!-- DPAPI. Not in the shared framework on .NET Core, so it is a package - and it is the floor
         under a saved password: ciphertext bound to the Windows account, so a copied file will not
         open elsewhere. Not private: nothing above needs to name it, but nothing above is harmed
         by being able to either, and it is Microsoft's own. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.6" />
  </ItemGroup>

</Project>
