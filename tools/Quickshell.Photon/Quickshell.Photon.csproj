<Project Sdk="Microsoft.NET.Sdk">

  <!-- The input-to-photon measurement, figure 1 (QS86). A tool and not a test, for the idle tool's
       reason: it puts a large topmost window on the desk for minutes and reads what the display did,
       which is a measurement of a desk and not a check a suite should repeat on every run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Quickshell.Photon</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quickshell.Terminal\Quickshell.Terminal.csproj" />
    <ProjectReference Include="..\..\src\Quickshell.Render\Quickshell.Render.csproj" />
  </ItemGroup>

</Project>
