<Project Sdk="Microsoft.NET.Sdk">

  <!-- The external judgement. Not under tests\, and deliberately: run-tests.cmd is the per-commit
       gate and this needs WSL, a Python suite fetched from elsewhere, and ninety seconds. It is a
       tool that writes a report the repository keeps, the same shape as the replay harness. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Quickshell.Conformance</RootNamespace>
    <AssemblyName>quickshell-conformance</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quickshell.App\Quickshell.App.csproj" />
  </ItemGroup>

  <!-- QS211: the Linux half of the judging path, handed to WSL's python on stdin. -->
  <ItemGroup>
    <None Include="pty-bridge.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


  <!-- QS315: the client's PDFsharp asks for System.Security.Cryptography.Pkcs 8.0.1, which carries two
       published advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). The client itself takes the
       framework's own copy, being a desktop app; this one is not, so it takes the patched release. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
