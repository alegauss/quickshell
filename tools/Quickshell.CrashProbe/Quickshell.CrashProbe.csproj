<Project Sdk="Microsoft.NET.Sdk">

  <!-- A process that really does die, which is the only way to prove the crash handler is hooked
       rather than merely written. It lives under tools\ and not under tests\ on purpose:
       run-tests.cmd runs every directory under tests\ as a test application and reads its exit
       code, and this program's whole job is to exit non-zero. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Quickshell.CrashProbe</RootNamespace>
    <!-- CrashGuard's default telling is a WPF dialog, so the assembly that holds it needs WPF even
         where this probe never shows one. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quickshell.App\Quickshell.App.csproj" />
  </ItemGroup>

</Project>
