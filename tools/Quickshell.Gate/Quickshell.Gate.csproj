<Project Sdk="Microsoft.NET.Sdk">

  <!-- The performance gate, QS79. A tool and not a test, for the startup tool's reason: it times a
       desk, and a suite that timed one on every run would be a suite whose verdict depended on
       what else the desk was doing. It runs where the figures are defined, and release.cmd runs it
       before an archive is made. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Quickshell.Gate</RootNamespace>
  </PropertyGroup>

</Project>
