<Project Sdk="Microsoft.NET.Sdk">

  <!-- The idle measurement. A tool and not a test: it takes ten minutes per subject and it measures
       another process, including the incumbent this project is arguing with, which is not something
       a suite should be doing on every run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Quickshell.Idle</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
