{
  // QS47, read through the accessibility tree rather than photographed. The strip is WPF chrome, so
  // unlike the terminal beside it there is something here worth reading: a TabControl publishes its
  // items and their names, which is exactly the claim a tab makes.
  //
  // The second tab is opened with Ctrl+Shift+T, the route a user takes (QS176: until winwright 1.0.0,
  // `press` spelled no chord, and this case started with `--tabs 2` instead).

  "fixtures": [
    {
      // One tab, which is the state that hides the strip; the case opens the second, because the
      // whole claim is about what appears when there is a choice to make.
      "name": "a window with one tab",
      // --tabs 1: a window asked for a tab opens on a shell, whatever startWith says (QS272).
      "arguments": ["--tabs", "1"],
      "shareable": false
    },
    {
      // Three tabs, one of which the numbering case closes (QS319).
      "name": "a window with three tabs to number",
      "arguments": ["--tabs", "3"],
      "shareable": false
    },
    {
      // Four tabs, the last on screen, for the middle click and the tab menu (QS347): what each closes is
      // one or two tabs that are not on screen, so which tab stays selected is part of the claim.
      "name": "a window with four tabs to close from",
      "arguments": ["--tabs", "4"],
      "shareable": false
    },
    {
      // Two tabs, so the strip is up; the case retitles the one on screen, short and then long (QS348).
      "name": "a window with two tabs to retitle",
      "arguments": ["--tabs", "2"],
      "shareable": false
    }
  ],

  "cases": [
    {
      "name": "a second tab brings the strip up carrying both of them",
      "catches": "a client that opens two sessions and shows one, or shows a strip with nothing selectable in it — which every test running inside the process would pass",
      "filed": "QS47",
      "tags": ["smoke", "window", "tabs"],
      "fixture": "a window with one tab",

      "steps": [
        {
          // At the terminal, the one thing in a window of one tab.
          "locator": "Document[class=\"Terminal\"]",
          "act": "press",
          "with": "Ctrl+Shift+T",
          "named": "a second tab is opened the way a user opens one"
        },
        {
          // Both ends of the strip, which is how two items are read without a word for "how many":
          // a left and a right that both resolve is a strip with at least two things in it, and one
          // tab publishes no strip at all.
          //
          // Read for which one is selected and not for a name, deliberately. The name is the title
          // ranked from three sources, and the middle one is the host's — cmd writes its own full
          // path through OSC within half a second, so what a tab is called is a string this machine
          // decides and not one this repository does. Which tab is on screen is this client's
          // answer in every case, and it is the more interesting half: a strip that came up showing
          // the tab the user did not just open would pass a check that only counted them.
          "locator": "TabItem[order=left]",
          "act": "read",
          "reads": "selected",
          "expect": "not selected",
          "named": "the first tab is there and is not the one on screen"
        },
        {
          "locator": "TabItem[order=right]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "and the second is, because it was opened last"
        },
        {
          // QS282: cmd writes its own path as its title, and a local tab is named as the shell
          // instead. An elevated cmd prefixes "Administrator: " (QS267), which is a title of its own
          // and shown as written, so that one is allowed too.
          "locator": "TabItem[order=left]",
          "act": "read",
          "reads": "name",
          "matches": "^(Command Prompt|Administrator: .+)$",
          "named": "a local tab is called by its shell, not by cmd.exe's path"
        },
        {
          // QS278 with winwright WW523: each tab publishes its state as its item status, the word
          // a screen reader says for the dot. Two local shells, so the leftmost and the rightmost
          // of the tabs found by that state are the two tabs, the first behind and the second on screen.
          "locator": "TabItem[status=\"Local\"][order=left]",
          "act": "read",
          "reads": "selected",
          "expect": "not selected",
          "named": "a local shell's tab says it is one"
        },
        {
          "locator": "TabItem[status=\"Local\"][order=right]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "and so does the other, the one on screen"
        },
        {
          // QS278: the strip carries New tab after the last tab and Commands at its right, as the
          // design draws it. Each tab's state is its ItemStatus, which no reading reaches yet
          // (winwright WW523); TabStripTests reads it in process until one does.
          "locator": "Button#NewTab",
          "act": "read",
          "reads": "name",
          "expect": "New tab",
          "named": "the strip offers a new tab"
        },
        {
          "locator": "Button#Commands",
          "act": "read",
          "reads": "name",
          "expect": "Commands",
          "named": "and every command, from the strip"
        }
      ]
    },
    {
      "name": "clicking a tab on the strip puts that tab's terminal on screen",
      "catches": "a strip whose highlight follows a click while the terminal under it stays the tab that was showing, so the keyboard types into a session the highlight does not name",
      "filed": "QS223",
      "tags": ["window", "tabs"],
      "fixture": "a window with one tab",

      "steps": [
        {
          // A name only the first tab has: cmd's own title command, which the tab takes as its title
          // and the window as its name while that tab is on screen.
          "locator": "Document[class=\"Terminal\"]",
          "act": "type",
          "with": "title first-tab-marker",
          "named": "the first tab is given a name of its own"
        },
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "press",
          "with": "Enter",
          "named": "and runs it"
        },
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "press",
          "with": "Ctrl+Shift+T",
          "named": "a second tab is opened, and is the one on screen"
        },
        {
          // A click, which is the act the defect was in: the chords already switched tabs.
          "locator": "TabItem[order=left]",
          "act": "click",
          "with": "PointerIsTheAct",
          "named": "the first tab is clicked on the strip"
        },
        {
          "locator": "TabItem[order=left]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "its highlight moved"
        },
        {
          // And the window is that tab's: its name is the title of the tab on screen, which is the
          // tab the keyboard types into. An elevated cmd - CI's runner is one - puts its own
          // "Administrator: " before every title it sets, and that prefix is all that may precede
          // it (QS267).
          "locator": "TitleBar",
          "act": "read",
          "reads": "name",
          "matches": "^(Administrator: +)?first-tab-marker",
          "named": "and so did the session on screen"
        },
        {
          // And the terminal on screen reads as the first tab's, from outside the process, through
          // the text pattern a screen reader uses: the command typed into it is there. Unreadable
          // from any other process until QS231.
          "locator": "Document[class=\"Terminal\"]",
          "act": "read",
          "reads": "text",
          "matches": "title first-tab-marker",
          "named": "and its text is the first tab's, read the way a screen reader reads it"
        }
      ]
    },
    {
      "name": "every tab carries its place on the strip, and closing one renumbers the rest",
      "catches": "two tabs on one host the strip gives nothing to tell apart by, or a number that stops matching the Alt chord once a tab closes",
      "filed": "QS319",
      "tags": ["window", "tabs"],
      "fixture": "a window with three tabs to number",

      "steps": [
        {
          "locator": "Text#TabNumber[order=left]",
          "act": "read",
          "reads": "name",
          "matches": "^1\\.",
          "named": "the first tab is numbered 1"
        },
        {
          "locator": "Text#TabNumber[order=left][index=2]",
          "act": "read",
          "reads": "name",
          "matches": "^2\\.",
          "named": "the second 2"
        },
        {
          "locator": "Text#TabNumber[order=right]",
          "act": "read",
          "reads": "name",
          "matches": "^3\\.",
          "named": "and the third 3"
        },
        {
          "locator": "Button#CloseTab[order=left][index=2]",
          "act": "invoke",
          "named": "the second tab is closed by its own cross"
        },
        {
          // Its shell is live, so closing it is asked about first.
          "locator": "Window#Closing > Button#close",
          "act": "invoke",
          "named": "and closing its live shell is agreed to"
        },
        {
          "locator": "Text#TabNumber[order=right]",
          "act": "read",
          "reads": "name",
          "matches": "^2\\.",
          "named": "the tab that was third is now 2, the Alt chord that reaches it"
        }
      ]
    },
    {
      // QS310 from outside the process, now that a click names its button (winwright WW538, in 1.1.1).
      "name": "a middle click on a tab closes that tab and leaves the one on screen",
      "catches": "a middle click that does nothing, closes the tab on screen instead of the one under the pointer, or closes a live shell without asking",
      "filed": "QS347",
      "tags": ["window", "tabs"],
      "fixture": "a window with four tabs to close from",

      "steps": [
        {
          "locator": "TabItem[order=left][index=2]",
          "act": "click",
          "with": "PointerIsTheAct",
          "button": "middle",
          "named": "the second tab is middle-clicked"
        },
        {
          // Its shell is live, so closing it is asked about first, as its cross would.
          "locator": "Window#Closing > Button#close",
          "act": "invoke",
          "named": "and closing its live shell is agreed to"
        },
        {
          "locator": "Text#TabNumber[order=right]",
          "act": "read",
          "reads": "name",
          "matches": "^3\\.",
          "named": "three tabs are left"
        },
        {
          "locator": "TabItem[order=right]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "and the tab that was on screen still is"
        }
      ]
    },
    {
      // QS311 from outside the process: the strip's own menu, opened by the right button.
      "name": "Close tabs to the right, from a tab's menu, asks once and closes the tabs after it",
      "catches": "a tab menu a right click does not open, a close that asks once per tab or not at all, or one that closes the wrong side",
      "filed": "QS347",
      "tags": ["window", "tabs"],
      "fixture": "a window with four tabs to close from",

      "steps": [
        {
          "locator": "TabItem[order=left][index=2]",
          "act": "click",
          "with": "PointerIsTheAct",
          "button": "right",
          "named": "the second tab is right-clicked"
        },
        {
          "locator": "MenuItem#CloseTabsToTheRight",
          "act": "invoke",
          "named": "and Close tabs to the right is chosen from its menu"
        },
        {
          // Two live shells, the third and the fourth: one question for both.
          "locator": "Window#Closing > Text#Asking",
          "act": "read",
          "reads": "name",
          "matches": "^Close 2 sessions\\?",
          "named": "one question names both sessions it would end"
        },
        {
          "locator": "Window#Closing > Button#close",
          "act": "invoke",
          "named": "and closing them is agreed to"
        },
        {
          "locator": "Text#TabNumber[order=right]",
          "act": "read",
          "reads": "name",
          "matches": "^2\\.",
          "named": "two tabs are left"
        },
        {
          // The tab on screen was closed, so the one clicked takes the screen, with the first behind it.
          "locator": "TabItem[order=right]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "the tab whose menu it was is on screen"
        },
        {
          "locator": "TabItem[order=left]",
          "act": "read",
          "reads": "selected",
          "expect": "not selected",
          "named": "and the first is behind it"
        }
      ]
    },
    {
      // QS348, the geometry QS312 fixed, from outside the process now that a step can claim where an
      // element is drawn (winwright WW539, in 1.1.2): the cross inside its own tab and not empty, at a
      // title shorter than the cross's padding and at one the strip has to make room for.
      "name": "a tab's close cross is drawn inside that tab at a short title and a long one",
      "catches": "a cross that paints nothing because its padding ate the button, or one pushed past its tab's edge by a long title",
      "filed": "QS348",
      "tags": ["window", "tabs"],
      "fixture": "a window with two tabs to retitle",

      "steps": [
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "type",
          "with": "title qs",
          "named": "the tab on screen is given a short title"
        },
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "press",
          "with": "Enter",
          "named": "and runs it"
        },
        {
          // The window's name is the title of the tab on screen (QS223's case), so it says the title
          // landed before the cross is measured against it.
          "locator": "TitleBar",
          "act": "read",
          "reads": "name",
          "matches": "^(Administrator: +)?qs( |$)",
          "named": "the short title is the tab's"
        },
        {
          "locator": "Button#CloseTab[order=right]",
          "act": "read",
          "within": "TabItem[order=right]",
          "named": "its cross is drawn inside it"
        },
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "type",
          "with": "title a-much-longer-host-name.example.invalid",
          "named": "the same tab is given a long title"
        },
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "press",
          "with": "Enter",
          "named": "and runs that"
        },
        {
          "locator": "TitleBar",
          "act": "read",
          "reads": "name",
          "matches": "^(Administrator: +)?a-much-longer-host-name\\.example\\.invalid",
          "named": "the long title is the tab's"
        },
        {
          "locator": "Button#CloseTab[order=right]",
          "act": "read",
          "within": "TabItem[order=right]",
          "named": "and its cross is still drawn inside it"
        }
      ]
    }
  ]
}
