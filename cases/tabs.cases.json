{
  // QS47, read through the accessibility tree rather than photographed. The strip is WPF chrome, so
  // unlike the terminal beside it there is something here worth reading: a TabControl publishes its
  // items and their names, which is exactly the claim a tab makes.
  //
  // The second tab is opened with Ctrl+Shift+T, the route a user takes (QS176: until winwright 1.0.0,
  // `press` spelled no chord, and this case started with `--tabs 2` instead).

  "fixtures": [
    {
      // One tab, which is the state that hides the strip; the case opens the second, because the
      // whole claim is about what appears when there is a choice to make.
      "name": "a window with one tab",
      "arguments": [],
      "shareable": false
    }
  ],

  "cases": [
    {
      "name": "a second tab brings the strip up carrying both of them",
      "catches": "a client that opens two sessions and shows one, or shows a strip with nothing selectable in it — which every test running inside the process would pass",
      "filed": "QS47",
      "tags": ["smoke", "window", "tabs"],
      "fixture": "a window with one tab",

      "steps": [
        {
          // At the terminal, the one thing in a window of one tab.
          "locator": "Document[class=\"Terminal\"]",
          "act": "press",
          "with": "Ctrl+Shift+T",
          "named": "a second tab is opened the way a user opens one"
        },
        {
          // Both ends of the strip, which is how two items are read without a word for "how many":
          // a left and a right that both resolve is a strip with at least two things in it, and one
          // tab publishes no strip at all.
          //
          // Read for which one is selected and not for a name, deliberately. The name is the title
          // ranked from three sources, and the middle one is the host's — cmd writes its own full
          // path through OSC within half a second, so what a tab is called is a string this machine
          // decides and not one this repository does. Which tab is on screen is this client's
          // answer in every case, and it is the more interesting half: a strip that came up showing
          // the tab the user did not just open would pass a check that only counted them.
          "locator": "TabItem[order=left]",
          "act": "read",
          "reads": "selected",
          "expect": "not selected",
          "named": "the first tab is there and is not the one on screen"
        },
        {
          "locator": "TabItem[order=right]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "and the second is, because it was opened last"
        }
      ]
    },
    {
      "name": "clicking a tab on the strip puts that tab's terminal on screen",
      "catches": "a strip whose highlight follows a click while the terminal under it stays the tab that was showing, so the keyboard types into a session the highlight does not name",
      "filed": "QS223",
      "tags": ["window", "tabs"],
      "fixture": "a window with one tab",

      "steps": [
        {
          // A name only the first tab has: cmd's own title command, which the tab takes as its title
          // and the window as its name while that tab is on screen.
          "locator": "Document[class=\"Terminal\"]",
          "act": "type",
          "with": "title first-tab-marker",
          "named": "the first tab is given a name of its own"
        },
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "press",
          "with": "Enter",
          "named": "and runs it"
        },
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "press",
          "with": "Ctrl+Shift+T",
          "named": "a second tab is opened, and is the one on screen"
        },
        {
          // A click, which is the act the defect was in: the chords already switched tabs.
          "locator": "TabItem[order=left]",
          "act": "click",
          "with": "PointerIsTheAct",
          "named": "the first tab is clicked on the strip"
        },
        {
          "locator": "TabItem[order=left]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "its highlight moved"
        },
        {
          // And the window is that tab's: its name is the title of the tab on screen, which is the
          // tab the keyboard types into.
          "locator": "TitleBar",
          "act": "read",
          "reads": "name",
          "matches": "^first-tab-marker",
          "named": "and so did the session on screen"
        },
        {
          // And the terminal on screen reads as the first tab's, from outside the process, through
          // the text pattern a screen reader uses: the command typed into it is there. Unreadable
          // from any other process until QS231.
          "locator": "Document[class=\"Terminal\"]",
          "act": "read",
          "reads": "text",
          "matches": "title first-tab-marker",
          "named": "and its text is the first tab's, read the way a screen reader reads it"
        }
      ]
    }
  ]
}
