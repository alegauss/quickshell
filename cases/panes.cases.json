{
  // QS48, read through the accessibility tree. A split is the one arrangement in this client where
  // a WPF-side check could pass while the window shows one terminal: the panes are child windows,
  // and only the tree says how many the client actually put on the desk.
  //
  // `--panes` and not the chord, for the reason the import and tabs cases give: `press` spells Tab
  // and the arrows and not Ctrl+Shift+\ (WW317, filed against the engine). It is a real surface, the
  // same standing as `--tabs`: this client has no menu, so the command line is the only way another
  // program can ask it for anything.

  "fixtures": [
    {
      "name": "a tab split in two",
      "arguments": ["--panes", "2"],
      "shareable": true
    },
    {
      // Its own and not lent: the case closes one of the panes (QS317).
      "name": "a tab split in two, to close a pane of",
      "arguments": ["--panes", "2"],
      "shareable": false
    }
  ],

  "cases": [
    {
      "name": "a split tab puts two terminals on the desk at once",
      "catches": "a client that builds the tree correctly and then shows one pane, or draws the second one on top of the first - which every test running inside the process would pass",
      "filed": "QS48",
      "tags": ["smoke", "window", "panes"],
      "fixture": "a tab split in two",

      "steps": [
        {
          // Both ends, which is how two are read without a word for how many. Each is a terminal
          // this client published for a screen reader, so an element at each end is two panes that
          // both got as far as having a buffer behind them.
          "locator": "Document[class=\"Terminal\"][order=left]",
          "act": "read",
          "reads": "name",
          "expect": "Terminal output",
          "named": "the pane on the left is a terminal with a buffer behind it"
        },
        {
          "locator": "Document[class=\"Terminal\"][order=right]",
          "act": "read",
          "reads": "name",
          "expect": "Terminal output",
          "named": "and so is the one beside it"
        },
        {
          // The handle a divider is dragged by, in the gap between the two (QS163). Found by its id
          // and read for its name, so the reading is not what found it.
          "locator": "Thumb#Divider",
          "act": "read",
          "reads": "name",
          "expect": "Pane divider",
          "named": "and between them is a divider a mouse can take hold of"
        }
      ]
    },
    {
      "name": "a pane of a split tab closes by the cross above it, and the tab is one pane again",
      "catches": "a pane opened by Split that can only be closed with its tab, or a cross that closes a pane other than its own",
      "filed": "QS317",
      "tags": ["window", "panes"],
      "fixture": "a tab split in two, to close a pane of",

      "steps": [
        {
          "locator": "Button#PaneClose[order=right]",
          "act": "read",
          "reads": "name",
          "expect": "Close pane",
          "named": "the right pane carries a close button above it"
        },
        {
          // `invoke`, so no foreground is needed: the pattern is the act.
          "locator": "Button#PaneClose[order=right]",
          "act": "invoke",
          "named": "which is pressed"
        },
        {
          // Its shell is live, so the closing question comes first, as it does for a tab.
          "locator": "Window#Closing > Button#close",
          "act": "invoke",
          "named": "and closing its live shell is agreed to"
        },
        {
          "locator": "Thumb#Divider",
          "act": "read",
          "absent": true,
          "named": "one pane is left: there is no divider"
        },
        {
          "locator": "Button#PaneClose",
          "act": "read",
          "absent": true,
          "named": "and no close button, since a tab of one pane has no strip"
        },
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "read",
          "reads": "name",
          "expect": "Terminal output",
          "named": "and the pane that stayed is still a terminal"
        }
      ]
    }
  ]
}