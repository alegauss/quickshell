{
  // QS80's outstanding criterion, and the first case that reads something worth reading.
  //
  // This dialog is the one that could not be photographed: Windows declined foreground twenty-five
  // times running on an unattended desk. Reading it needs neither, which is QS147's whole point.
  //
  // `--import <file>` and not Ctrl+Shift+I, though the engine can press the chord since winwright
  // 1.0.0 (QS176): the chord previews whatever MobaXterm file this desk has, and the flag is the one
  // route that names a file — so the same preview is read on every desk. The flag is not a test hook:
  // a client with no menu has the command line as a real surface, and it is the only one a script or
  // another program can reach.

  "fixtures": [
    {
      // The dialog opens over the window rather than instead of it, so the fixture is the
      // application with the flag on.
      //
      // Given a file, and not left to find whatever this desk has installed (QS181): a desk with no
      // MobaXterm shows an OK-only notice instead of the Yes/No preview, so the same case asserted
      // two different dialogs depending on where it ran. The file is synthetic and committed; the
      // path is relative to the repository, which the engine makes the application's working
      // directory since winwright 1.0.1 (WW508).
      "name": "the import preview",
      "arguments": ["--import", "cases/fixtures/MobaXterm.ini"],
      "shareable": true
    }
  ],

  "cases": [
    {
      "name": "the import preview is up and offers a way to refuse it",
      "catches": "an import that writes first and reports afterwards, or a preview with no way out of it",
      "filed": "QS80",
      "tags": ["smoke", "import"],
      "fixture": "the import preview",

      "steps": [
        {
          // Found by its automation id and read for its name, so the locator does not fix the
          // reading. Since QS131 this is the client's own Choice window and not Windows' message
          // box, whose buttons said "Sim" and "Não" on this desk beside this client's English. The
          // counts and the path in the body are not assertable, because `expect` is equality and
          // both change with the machine.
          "locator": "Window#Choice",
          "act": "read",
          "expect": "Import sessions",
          "reads": "name",
          "named": "the preview is on the desk under its own caption"
        },
        {
          // The way out, found by what it means and read for what it says: the button names the
          // act, in this client's words, whatever language Windows is in (QS131).
          "locator": "Window#Choice > Button#no",
          "act": "read",
          "expect": "Don't import",
          "reads": "name",
          "named": "refusing says what it does"
        },
        {
          // `invoke` and not `click`: the pattern is the act, and a synthesised pointer would need
          // the foreground this whole exercise exists to stop needing.
          "locator": "Window#Choice > Button#no",
          "act": "invoke",
          "named": "refusing the import, which is what writes nothing"
        }
      ]
    }
  ]
}
