{
  // QS60, read through the accessibility tree. Opened by `--browse` and not from the palette, for
  // the reason palette.cases.json gives: the engine this repository restores cannot yet type into
  // one window and act in another (QS176), and the flag is the same real surface `--palette` is.
  //
  // What is asserted is what the browser is for on a tab that runs a local shell: this machine's
  // half opens on a directory and lists it, and the other half says in words why it is empty. The
  // listing's content belongs to the machine, so it is matched for being there and not read for what
  // it holds; the sentence belongs to this repository, so it is read whole.

  "fixtures": [
    {
      "name": "the file browser over a local tab",
      "arguments": ["--tabs", "1", "--browse"],
      "shareable": true
    },
    {
      // QS292. Connected to the guest's own sshd as connected.cases.json's fixture is
      // (tools\provision-guest-sshd.ps1), with an Explorer folder opened beside the client for the
      // drop to land in (winwright WW536). Where nothing answers at 127.0.0.1:2240 the case is a
      // hole naming the address.
      "name": "a client connected to the guest's server, beside an Explorer folder",
      "reaches": ["127.0.0.1:2240"],
      "arguments": ["--session", "probe"],
      "variables": { "QUICKSHELL_DATA": "{files}" },
      "files": [
        { "from": "cases/fixtures/connected.json", "to": "sessions.json" }
      ],
      "opens": "{files}/qs292-landing"
    }
  ],

  "cases": [
    {
      "name": "the browser opens on this computer, lists it, and says why it has no remote side",
      "catches": "a browser that opens on nothing, lists nothing until a directory finishes, or leaves its remote half blank with no word about why - each of which a test inside the process could pass while the window showed it",
      "filed": "QS60",
      "tags": ["browser"],
      "fixture": "the file browser over a local tab",

      "steps": [
        {
          // The one path box there is on a local tab, and read for its value: a directory of this
          // machine, which is all the claim can say about a path the machine decides. Named, since
          // the sessions sidebar's search box is an Edit too (QS268).
          "locator": "Edit[name=\"Path on This computer\"]",
          "act": "read",
          "reads": "value",
          "matches": "^[A-Za-z]:\\\\",
          "named": "this computer's half opened on one of its directories"
        },
        {
          // The first row, read for being something. A user profile that lists nothing is a pane
          // that never listed.
          "locator": "DataItem[order=top]",
          "act": "read",
          "reads": "name",
          "matches": ".",
          "named": "and listed what is in it"
        },
        {
          "locator": "Text[order=right]",
          "act": "read",
          "reads": "name",
          "expect": "This tab is a local shell, so there is no remote side to list.",
          "named": "the other half says why it is empty"
        }
      ]
    },
    {
      "name": "a file dragged from the host's side lands in an Explorer folder byte for byte",
      "catches": "a drag out of the remote pane that drops nothing, a file of the wrong length, or one whose bytes were not the server's",
      "filed": "QS292",
      "tags": ["browser", "connected"],
      "fixture": "a client connected to the guest's server, beside an Explorer folder",

      "steps": [
        {
          "locator": "Window#Choice > Button#once",
          "act": "invoke",
          "named": "the server's key is trusted for this connection only"
        },
        {
          "locator": "TabItem[status=\"Connected\"]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "the session is connected in its tab"
        },
        {
          // Read before the browser is opened: the file channel opens beside the shell (QS219), and
          // a browser opened before it has no remote half for good.
          "locator": "Text#ConnectionStatus",
          "act": "read",
          "reads": "name",
          "matches": "^Connected to 127\\.0\\.0\\.1",
          "named": "the status bar says where it is connected"
        },
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "press",
          "with": "Ctrl+Shift+P",
          "named": "the palette is opened"
        },
        {
          "locator": "Edit[name=\"Command\"]",
          "act": "set value",
          "with": "Browse files",
          "expect": "Browse files",
          "reads": "value",
          "named": "for the file browser"
        },
        {
          "locator": "Edit[name=\"Command\"]",
          "act": "press",
          "with": "Enter",
          "named": "and the browser is opened"
        },
        {
          // The server is this same machine, and its account reads the guest's checkout, where
          // tools\vm-guest.ps1 puts it: the fixture's staged folder is under the runner's own profile,
          // which it cannot. Spelled whole until a step can name the project's root (winwright WW542).
          "locator": "Edit[name=\"Path on 127.0.0.1\"]",
          "act": "set value",
          "with": "/C:/src/quickshell/cases/fixtures",
          "expect": "/C:/src/quickshell/cases/fixtures",
          "reads": "value",
          "named": "the host's side is pointed at the folder holding the file"
        },
        {
          "locator": "Edit[name=\"Path on 127.0.0.1\"]",
          "act": "press",
          "with": "Enter",
          "named": "and lists it"
        },
        {
          "locator": "DataItem[name=\"drop.bin\"]",
          "act": "drag",
          "to": "Window[nameStarts=\"qs292-landing\"] > List[class=UIItemsView]",
          "toDesktop": true,
          "named": "the file is dragged onto the Explorer folder"
        },
        {
          "file": "{files}/qs292-landing/drop.bin",
          "act": "read",
          "sameBytesAs": "cases/fixtures/drop.bin",
          "named": "and lands there with the server's bytes"
        }
      ]
    }
  ]
}
