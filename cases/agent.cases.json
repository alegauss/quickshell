{
  // QS335. What an agent does through the gateway, shown to the person as a tab of its own. The
  // gateway is another process, and writes a feed under the client's data folder; this fixture stages
  // one, a run of two calls as the gateway writes it, and the client opens it at start. The client
  // opens only feeds written in the last ten minutes, which a staged copy is, being written now
  // (winwright WW543, in 1.1.2).

  "fixtures": [
    {
      "name": "a client whose data folder holds an agent's feed",
      "variables": { "QUICKSHELL_DATA": "{files}" },
      "files": [
        { "from": "cases/fixtures/agent-feed.vt", "to": "agent-feeds/20261016T000000Z-0c4a1e.vt" }
      ]
    },
    {
      // QS337. A request the gateway left for the person: two calls, one on a prod session. The window
      // answers requests younger than the gateway's patience, which a copy staged now is.
      "name": "a client with an agent's request waiting for the person",
      "variables": { "QUICKSHELL_DATA": "{files}" },
      "files": [
        { "from": "cases/fixtures/agent-ask.json", "to": "agent-asks/ui0001.ask.json" }
      ]
    },
    {
      // QS339. A policy some script widened outside quickshell, beside the version the person approved.
      "name": "a client whose agent policy was changed outside it",
      "variables": { "QUICKSHELL_DATA": "{files}" },
      "files": [
        { "from": "cases/fixtures/agent-policy-widened.json", "to": "agent-policy.json" },
        { "from": "cases/fixtures/agent-policy-approved.json", "to": "agent-policy.json.approved" }
      ]
    },
    {
      // QS342. A session on the guest's own sshd under a folder tagged prod, with the gateway on and a
      // stand-in where Claude Code would run.
      "name": "a client connected to prod, with a Claude Code pane to send to",
      "reaches": ["127.0.0.1:2240"],
      "arguments": ["--session", "Customer/probe"],
      "variables": { "QUICKSHELL_DATA": "{files}" },
      "files": [
        { "from": "cases/fixtures/tagged.json", "to": "sessions.json" },
        { "from": "cases/fixtures/claude-settings.json", "to": "settings.json" }
      ]
    }
  ],

  "cases": [
    {
      "name": "an agent's run is a tab badged as the agent's, ending on its last call",
      "catches": "an agent working through the gateway with nothing on the person's screen, or a tab that looks like any human session",
      "filed": "QS335",
      "tags": ["agent", "tabs"],
      "fixture": "a client whose data folder holds an agent's feed",

      "steps": [
        {
          // The badge is a chip on the tab, in the accent, as a tag is.
          "locator": "Text#TabTag",
          "act": "read",
          "reads": "name",
          "expect": "agent",
          "named": "the agent's tab wears its badge"
        },
        {
          "locator": "TabItem[order=right]",
          "act": "select",
          "named": "the agent's tab is put on screen"
        },
        {
          // Read the way a screen reader reads a terminal: both calls are there, the last with its result.
          "locator": "Document[class=\"Terminal\"]",
          "act": "read",
          "reads": "text",
          "matches": "agent probe exec uptime[\\s\\S]*agent probe exec systemctl is-active nginx\\s+active\\s+\\[exit 0\\]",
          "named": "and shows both calls, the last one ending as it did"
        }
      ]
    },
    {
      "name": "an agent's request is shown call by call in quickshell, and approving it answers that batch",
      "catches": "an approval drawn where the agent controls what is printed, a command shown as one string a quote can hide a second in, a prod session not marked, or an answer not bound to what was shown",
      "filed": "QS337",
      "tags": ["agent", "approval"],
      "fixture": "a client with an agent's request waiting for the person",

      "steps": [
        {
          "locator": "Text#AskCommand[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "‹systemctl› ‹restart› ‹postgresql›",
          "named": "the first call is shown as the words it runs"
        },
        {
          "locator": "Text#AskCommand[order=bottom]",
          "act": "read",
          "reads": "name",
          "expect": "‹systemctl› ‹restart› ‹nginx›",
          "named": "and the second, in the order they run"
        },
        {
          "locator": "Text#AskProd",
          "act": "read",
          "reads": "name",
          "expect": "prod",
          "named": "the prod session is marked"
        },
        {
          "locator": "Text#PlanHash",
          "act": "read",
          "reads": "name",
          "expect": "Plan c40df47bd272",
          "named": "with the batch's short hash, which the agent's request carries too"
        },
        {
          "locator": "Button#Approve",
          "act": "invoke",
          "named": "the person runs it"
        },
        {
          // The answer names the hash of exactly what was shown.
          "file": "{files}/agent-asks/ui0001.answer.json",
          "act": "read",
          "sameBytesAs": "cases/fixtures/agent-ask-approved.json",
          "named": "and the answer approves that batch and nothing else"
        }
      ]
    },
    {
      "name": "an agent policy changed outside quickshell is shown as its diff, and rejecting it puts the approved one back",
      "catches": "an agent that writes its own policy and gains what it wrote, or a change the person is asked about without being shown it",
      "filed": "QS339",
      "tags": ["agent", "policy"],
      "fixture": "a client whose agent policy was changed outside it",

      "steps": [
        {
          "locator": "Text#PolicyDiff",
          "act": "read",
          "reads": "name",
          "matches": "\\+\\s+\"grants\".*\"level\": \"break-glass\"",
          "named": "the change is shown as what was added"
        },
        {
          "locator": "Button#RejectPolicy",
          "act": "invoke",
          "named": "the person rejects it"
        },
        {
          "file": "{files}/agent-policy.json",
          "act": "read",
          "sameBytesAs": "cases/fixtures/agent-policy-approved.json",
          "named": "and the policy is the approved one again, byte for byte"
        }
      ]
    },
    {
      "name": "Send to Claude gives the Claude Code pane the screen of a session, with where it came from",
      "catches": "a Claude pane started without the gateway's configuration, or text sent to it with no session or tags, or sent nowhere",
      "filed": "QS342",
      "tags": ["agent", "palette"],
      "fixture": "a client connected to prod, with a Claude Code pane to send to",

      "steps": [
        {
          "locator": "Window#Choice > Button#once",
          "act": "invoke",
          "named": "the server's key is trusted for this connection only"
        },
        {
          "locator": "TabItem[status=\"Connected\"]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "the session is connected in its tab"
        },
        {
          "locator": "TabItem[status=\"Connected\"]",
          "act": "press",
          "with": "Ctrl+Shift+P",
          "named": "the palette is opened the way a user opens it"
        },
        {
          "locator": "Edit[name=\"Command\"]",
          "act": "set value",
          "with": "send to claude",
          "expect": "send to claude",
          "reads": "value",
          "named": "the command, by its words"
        },
        {
          "locator": "List[name=\"Commands\"] > ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "Send to Claude",
          "named": "is in the palette"
        },
        {
          // Nothing is selected, so what is sent is the session's screen. No Claude pane is open yet,
          // so the command opens one first and waits for it to draw.
          "locator": "Edit[name=\"Command\"]",
          "act": "press",
          "with": "Enter",
          "named": "and taken"
        },
        {
          // The stand-in's first line is the command line the pane was started with: the gateway as its
          // MCP server and the hook's settings, both written into the client's data folder. The pane is
          // narrow and the data folder's path long, so the paths wrap mid-word and are matched across
          // the breaks. The stand-in asked for no bracketed paste, so it runs each line it is sent;
          // Claude Code asks, and takes them as one paste.
          "locator": "Document[class=\"Terminal\"]",
          "act": "read",
          "reads": "text",
          "matches": "claude-stand-in --mcp-config [\\s\\S]*claude-mcp\\.json[\\s\\S]*--settings [\\s\\S]*claude-settings[\\s\\S]*>From Customer/probe \\(tags: prod\\):",
          "named": "the Claude pane is on screen, started with the gateway, and holds the text with its session and tags"
        }
      ]
    }
  ]
}
