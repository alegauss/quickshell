{
  // QS52. Opened by Ctrl+Shift+P, which is the route a user actually takes (QS176: until winwright
  // 1.0.0, `press` spelled no chord, and this case opened the palette with `--palette` instead).
  //
  // Every claim here is made by typing and then reading what rose to the top. That shape is forced:
  // the engine refuses a step whose locator already matched on the property it goes on to read, so
  // `ListItem[name="…"]` cannot assert its own name. It is the better case for it. Addressing an
  // entry by position and reading what landed there is the whole of what a palette does, and a case
  // that named the entry it wanted would have proved only that the entry exists.

  "fixtures": [
    {
      // Two tabs, so the list has the tab entries in it and the stepping commands can run. One tab
      // is a smaller palette and a less interesting one.
      //
      // Named for what it is for and not for what it holds: a fixture name is global across every
      // case file here, so "a window with two tabs" is already taken by tabs.cases.json — and two
      // declarations of one name are two launches a case naming it cannot choose between.
      "name": "a window to open the palette over",
      "arguments": ["--tabs", "2"],
      "shareable": true
    },
    {
      // A session store of the case's own, so the session it types for is one it knows is there
      // on every desk (QS217). Staged by the engine into a directory of this launch's own (WW509)
      // and named by QUICKSHELL_DATA, because the client's usual store is under %AppData%, a known
      // folder no variable redirects (winwright WW519). Not lent: its store is not the other
      // cases' window.
      "name": "a client over a store of its own",
      // Two tabs only so the chord has a tab on the strip to be pressed at, as above.
      "arguments": ["--tabs", "2"],
      "variables": { "QUICKSHELL_DATA": "{files}" },
      "files": ["cases/fixtures/sessions.json"]
    }
  ],

  "cases": [
    {
      "name": "the palette lists what this client can do, and initials find it",
      "catches": "a palette whose list is built from a second, hand-maintained list of actions — which drifts, and which no test inside the process would notice because it would be asking the same list",
      "filed": "QS52",
      "tags": ["smoke", "palette"],
      "fixture": "a window to open the palette over",

      "steps": [
        {
          // The chord a user presses, at the window — addressed by the tab on screen, the one element
          // of two tabs' worth that names a single thing.
          "locator": "TabItem[order=right]",
          "act": "press",
          "with": "Ctrl+Shift+P",
          "named": "the palette is opened the way a user opens it"
        },
        {
          // The palette's own box. `set value` and not synthesised keystrokes: the pattern is the
          // act, and a keystroke would need the foreground this whole exercise exists to stop
          // needing.
          "locator": "Edit",
          "act": "set value",
          "with": "sac",
          "expect": "sac",
          "reads": "value",
          "named": "three initials, in the order somebody would type them"
        },
        {
          // Addressed by where it is and read for what it says, which is the only shape that can
          // claim anything: no substring of "Show all commands" reads "sac".
          //
          // That the palette lists itself is the deliberate half. A list with a hole in it is a
          // list somebody has to remember the shape of.
          "locator": "ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "Show all commands",
          "named": "the palette is up and lists itself"
        },
        {
          "locator": "Edit",
          "act": "set value",
          "with": "spr",
          "expect": "spr",
          "reads": "value",
          "named": "and again, for a command with no other route but a chord"
        },
        {
          "locator": "ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "Split pane right",
          "named": "initials find the phrase, which is why this is worth opening"
        },
        {
          "locator": "Edit",
          "act": "set value",
          "with": "eqp",
          "expect": "eqp",
          "reads": "value",
          "named": "an action a user would never find without this"
        },
        {
          // Equalising panes is reachable by Ctrl+Shift+E and by nothing else in the window. If the
          // list were maintained beside the bindings rather than derived from them, this is the
          // entry somebody would have forgotten.
          "locator": "ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "Equalise panes",
          "named": "and it is here, without anybody having added it to a second list"
        },
        {
          "locator": "Edit",
          "act": "set value",
          "with": "new session",
          "expect": "new session",
          "reads": "value",
          "named": "the way into the session store (QS121)"
        },
        {
          // The session dialog had no way in at all until QS121: built and tested, and reachable
          // from nothing a user could do. This is the entry that makes it a feature.
          "locator": "ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "New session",
          "named": "and a session can be made from the running client"
        },
        {
          "locator": "Edit",
          "act": "set value",
          "with": "move tab",
          "expect": "move tab",
          "reads": "value",
          "named": "moving the tab on screen along the strip (QS160)"
        },
        {
          // Left and not right: the tab on screen is the last one opened, so there is nowhere right
          // for it to go and the palette does not offer the move. What rises is the one that can run.
          "locator": "ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "Move tab left",
          "named": "and only the move that can happen is offered"
        },
        {
          "locator": "Edit",
          "act": "set value",
          "with": "settings",
          "expect": "settings",
          "reads": "value",
          "named": "the window over the settings file (QS170)"
        },
        {
          "locator": "ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "Settings",
          "named": "is reachable from the palette as well as its chord"
        },
        {
          "locator": "Edit",
          "act": "set value",
          "with": "open session",
          "expect": "open session",
          "reads": "value",
          "named": "the way to a saved session (QS217)"
        },
        {
          // Until QS217 a saved session could only be opened by typing its path on a command line.
          // Offered only where the program wired sessions to open, which the client always does.
          "locator": "ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "Open session",
          "named": "and a saved session is reached from the palette"
        },
        {
          "locator": "Edit",
          "act": "set value",
          "with": "show forwards",
          "expect": "show forwards",
          "reads": "value",
          "named": "the view of every forward this client holds (QS70)"
        },
        {
          // A forward has no window of its own, so this is the one place it can be seen.
          "locator": "ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "Show forwards",
          "named": "and the forwards are reachable from the palette"
        }
      ]
    },
    {
      "name": "a recording is asked about before anything is recorded, and can be refused",
      "catches": "a recording started by a palette entry with no question first — a client writing somebody's session to disk on one keystroke — or a question with no way to say no",
      "filed": "QS134",
      "tags": ["palette", "recording"],
      "fixture": "a window to open the palette over",

      "steps": [
        {
          "locator": "TabItem[order=right]",
          "act": "press",
          "with": "Ctrl+Shift+P",
          "named": "the palette is opened the way a user opens it"
        },
        {
          "locator": "Edit",
          "act": "set value",
          "with": "new tab recorded",
          "expect": "new tab recorded",
          "reads": "value",
          "named": "the way to record a session from its first byte"
        },
        {
          "locator": "ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "New tab, recorded",
          "named": "is in the palette"
        },
        {
          "locator": "Edit",
          "act": "press",
          "with": "Enter",
          "named": "and taken"
        },
        {
          // The question, before any tab or file: its terms name the desk's own folder, so what is
          // read is the dialog's caption and its way out, which mean the same on every desk.
          "locator": "Window#Recording",
          "act": "read",
          "reads": "name",
          "expect": "Record a session",
          "named": "a question comes first, under its own caption"
        },
        {
          "locator": "Window#Recording > Button#decline",
          "act": "read",
          "reads": "name",
          "expect": "Don't record",
          "named": "and refusing says what it does"
        },
        {
          "locator": "Window#Recording > Button#decline",
          "act": "invoke",
          "named": "refusing it, which records nothing"
        }
      ]
    },
    {
      "name": "part of a saved session's name brings it to the top of Open session",
      "catches": "an Open session list that reads some other store than the one the client was given, or one that lists sessions without finding them by what a user remembers of the name",
      "filed": "QS217",
      "tags": ["palette", "sessions"],
      "fixture": "a client over a store of its own",

      "steps": [
        {
          "locator": "TabItem[order=right]",
          "act": "press",
          "with": "Ctrl+Shift+P",
          "named": "the palette is opened the way a user opens it"
        },
        {
          "locator": "Edit",
          "act": "set value",
          "with": "open session",
          "expect": "open session",
          "reads": "value",
          "named": "the way to a saved session"
        },
        {
          // Enter takes what is selected, which is the top of the list: the same key a user presses.
          "locator": "Edit",
          "act": "press",
          "with": "Enter",
          "named": "and taken"
        },
        {
          // Found by the name the session palette gives its box, which the command palette's box
          // does not have: reaching it at all is reading that the second palette is up.
          "locator": "Edit[name=\"Session\"]",
          "act": "set value",
          "with": "primary",
          "expect": "primary",
          "reads": "value",
          "named": "a word of the name somebody remembers, not its path"
        },
        {
          // Only in the store this fixture staged. A client reading the desk's own store would show
          // something else here, or nothing.
          "locator": "ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "Work/db-primary",
          "named": "the session rises to the top by its path"
        },
        {
          "locator": "Edit[name=\"Session\"]",
          "act": "set value",
          "with": "nas",
          "expect": "nas",
          "reads": "value",
          "named": "and another, from another folder"
        },
        {
          "locator": "ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "Home/nas",
          "named": "is found the same way"
        },
        {
          // Escape and not Enter: choosing would open an SSH tab to a host that is not there.
          "locator": "Edit[name=\"Session\"]",
          "act": "press",
          "with": "Escape",
          "named": "and the list is left without opening anything"
        }
      ]
    }
  ]
}
