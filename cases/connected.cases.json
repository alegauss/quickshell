{
  // QS273. A connected tab's session bar and status bar, read from outside the process. The bars
  // exist only while a pane holds a live SSH session, so this fixture reaches the guest's own sshd,
  // which tools\provision-guest-sshd.ps1 sets up once (Windows OpenSSH on 127.0.0.1:2240, the owner's
  // choice on 2026-10-13), and opens one session on it by --session. Not the Docker fixture's 2222:
  // UI cases run in the guest, which has no Docker. The bars are Borders, which publish nothing, so
  // each step reads the words inside them by their own ids.
  //
  // Where nothing answers at that address (a guest not yet provisioned) the client is never
  // launched and every check below is a hole naming the address, never a pass (winwright WW522).
  // The in-process half, against the Docker fixture where a desk has it, is RemoteShellTests'
  // TheSessionBarSaysWhereATabGoesAndWhichForwardsItHolds.

  "fixtures": [
    {
      // The store, staged as the client's data folder; its session signs in with the key the
      // provisioning made in the guest. Not lent: the case answers the host-key question.
      "name": "a client connected to the guest's server",
      "reaches": ["127.0.0.1:2240"],
      "arguments": ["--session", "probe"],
      "variables": { "QUICKSHELL_DATA": "{files}" },
      "files": [
        { "from": "cases/fixtures/connected.json", "to": "sessions.json" }
      ]
    },
    {
      // A session under a folder tagged prod (QS331), opened by its path.
      "name": "a client connected to a session filed under prod",
      "reaches": ["127.0.0.1:2240"],
      "arguments": ["--session", "Customer/probe"],
      "variables": { "QUICKSHELL_DATA": "{files}" },
      "files": [
        { "from": "cases/fixtures/tagged.json", "to": "sessions.json" }
      ]
    }
  ],

  "cases": [
    {
      "name": "a connected tab says where it goes, that it is up, and which forwards it holds",
      "catches": "a session bar that is missing over a live session, says the wrong state, or omits a forward the session opened",
      "filed": "QS273",
      "tags": ["sessions", "connected"],
      "fixture": "a client connected to the guest's server",

      "steps": [
        {
          // Trusted this time and not remembered, so nothing is written to known_hosts and every run
          // meets the same question. A desk that once remembered 127.0.0.1:2240 and has since
          // reinstalled its sshd refuses the new key outright; remove that line from
          // %USERPROFILE%\.ssh\known_hosts.
          "locator": "Window#Choice > Button#once",
          "act": "invoke",
          "named": "the server's key is trusted for this connection only"
        },
        {
          "locator": "Text#SessionName",
          "act": "read",
          "reads": "name",
          "expect": "probe",
          "named": "the session bar names the session"
        },
        {
          "locator": "Text#ConnectionState",
          "act": "read",
          "reads": "name",
          "expect": "Connected",
          "named": "and says it is up, in a word"
        },
        {
          "locator": "Button#Forward",
          "act": "read",
          "reads": "name",
          "matches": "^Forward \\d+ → localhost:2240$",
          "named": "the forward the session opened is a chip beside it"
        },
        {
          "locator": "Text#ConnectionStatus",
          "act": "read",
          "reads": "name",
          "matches": "^Connected to 127\\.0\\.0\\.1",
          "named": "and the status bar says where it is connected"
        },
        {
          // QS278 with WW523: the tab is found by the state it publishes, not by its title.
          "locator": "TabItem[status=\"Connected\"]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "the connected tab is found by its state"
        }
      ]
    },
    {
      "name": "a connected session's card on Home goes to its tab, and offers a new connection beside it",
      "catches": "a card that says Connected now and opens a second connection, with no way from Home to the tab already open",
      "filed": "QS313",
      "tags": ["sessions", "connected", "home"],
      "fixture": "a client connected to the guest's server",

      "steps": [
        {
          "locator": "Window#Choice > Button#once",
          "act": "invoke",
          "named": "the server's key is trusted for this connection only"
        },
        {
          "locator": "TabItem[status=\"Connected\"]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "the session is connected in its tab"
        },
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "press",
          "with": "Ctrl+Shift+P",
          "named": "the palette is opened"
        },
        {
          "locator": "Edit[name=\"Command\"]",
          "act": "set value",
          "with": "home",
          "expect": "home",
          "reads": "value",
          "named": "for Home"
        },
        {
          "locator": "Edit[name=\"Command\"]",
          "act": "press",
          "with": "Enter",
          "named": "and Home is shown"
        },
        {
          // The card's main button is the tab's, not another connection's.
          "locator": "Button#CardGoTo",
          "act": "read",
          "reads": "name",
          "expect": "Go to tab probe",
          "named": "the card of the connected session offers to go to its tab"
        },
        {
          "locator": "Button#CardGoTo",
          "act": "invoke",
          "named": "which is taken"
        },
        {
          "locator": "TabItem[status=\"Connected\"]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "and the connected tab is on screen again, with no second one opened"
        },
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "press",
          "with": "Ctrl+Shift+P",
          "named": "the palette is opened again"
        },
        {
          "locator": "Edit[name=\"Command\"]",
          "act": "set value",
          "with": "home",
          "expect": "home",
          "reads": "value",
          "named": "for Home"
        },
        {
          "locator": "Edit[name=\"Command\"]",
          "act": "press",
          "with": "Enter",
          "named": "and Home is shown"
        },
        {
          "locator": "Button#CardNewConnection",
          "act": "invoke",
          "named": "this time a new connection is asked for"
        },
        {
          // A second connection meets the host-key question again, trusted once as the first was.
          "locator": "Window#Choice > Button#once",
          "act": "invoke",
          "named": "its server's key is trusted for this connection only"
        },
        {
          "locator": "TabItem[order=right]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "and a second tab is open and on screen"
        },
        {
          "locator": "TabItem[order=left]",
          "act": "read",
          "reads": "selected",
          "expect": "not selected",
          "named": "with the first still there behind it"
        }
      ]
    },
    {
      "name": "the session bar's Split can split one pane above the other",
      "catches": "a session bar whose Split only ever makes columns, so a mouse can never split a terminal top and bottom",
      "filed": "QS318",
      "tags": ["sessions", "connected", "panes"],
      "fixture": "a client connected to the guest's server",

      "steps": [
        {
          "locator": "Window#Choice > Button#once",
          "act": "invoke",
          "named": "the server's key is trusted for this connection only"
        },
        {
          "locator": "Button#SessionSplitMore",
          "act": "invoke",
          "named": "the chevron beside Split is opened"
        },
        {
          "locator": "MenuItem#SessionSplitDown",
          "act": "read",
          "reads": "name",
          "expect": "Split down",
          "named": "and offers to split down"
        },
        {
          "locator": "MenuItem#SessionSplitDown",
          "act": "invoke",
          "named": "which is chosen"
        },
        {
          // The new pane opens the same session (QS309), so its server's key is asked about too.
          "locator": "Window#Choice > Button#once",
          "act": "invoke",
          "named": "the second connection's key is trusted for it only"
        },
        {
          "locator": "Document[class=\"Terminal\"][order=top]",
          "act": "read",
          "reads": "name",
          "expect": "Terminal output",
          "named": "there is a terminal at the top"
        },
        {
          "locator": "Document[class=\"Terminal\"][order=bottom]",
          "act": "read",
          "reads": "name",
          "expect": "Terminal output",
          "named": "and one under it"
        },
        {
          "locator": "Thumb#Divider",
          "act": "read",
          "reads": "name",
          "expect": "Pane divider",
          "named": "with a divider between them"
        }
      ]
    },
    {
      "name": "a session filed under a prod folder says prod on its tab",
      "catches": "a store that knows a session is production while the strip shows it like any other",
      "filed": "QS331",
      "tags": ["sessions", "connected", "tabs"],
      "fixture": "a client connected to a session filed under prod",

      "steps": [
        {
          "locator": "Window#Choice > Button#once",
          "act": "invoke",
          "named": "the server's key is trusted for this connection only"
        },
        {
          "locator": "TabItem[status=\"Connected\"]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "the session is connected in its tab"
        },
        {
          // The tag is the folder's: the session names none of its own.
          "locator": "Text#TabProdWord",
          "act": "read",
          "reads": "name",
          "expect": "prod",
          "named": "and its tab says prod, inherited from its folder"
        }
      ]
    }
  ]
}
