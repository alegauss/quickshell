{
  // QS273. A connected tab's session bar and status bar, read from outside the process. The bars
  // exist only while a pane holds a live SSH session, so this fixture reaches the guest's own sshd,
  // which tools\provision-guest-sshd.ps1 sets up once (Windows OpenSSH on 127.0.0.1:2240, the owner's
  // choice on 2026-10-13), and opens one session on it by --session. Not the Docker fixture's 2222:
  // UI cases run in the guest, which has no Docker. The bars are Borders, which publish nothing, so
  // each step reads the words inside them by their own ids.
  //
  // Where nothing answers at that address (a guest not yet provisioned) the client is never
  // launched and every check below is a hole naming the address, never a pass (winwright WW522).
  // The in-process half, against the Docker fixture where a desk has it, is RemoteShellTests'
  // TheSessionBarSaysWhereATabGoesAndWhichForwardsItHolds.

  "fixtures": [
    {
      // The store, staged as the client's data folder; its session signs in with the key the
      // provisioning made in the guest. Not lent: the case answers the host-key question.
      "name": "a client connected to the guest's server",
      "reaches": ["127.0.0.1:2240"],
      "arguments": ["--session", "probe"],
      "variables": { "QUICKSHELL_DATA": "{files}" },
      "files": [
        { "from": "cases/fixtures/connected.json", "to": "sessions.json" }
      ]
    }
  ],

  "cases": [
    {
      "name": "a connected tab says where it goes, that it is up, and which forwards it holds",
      "catches": "a session bar that is missing over a live session, says the wrong state, or omits a forward the session opened",
      "filed": "QS273",
      "tags": ["sessions", "connected"],
      "fixture": "a client connected to the guest's server",

      "steps": [
        {
          // Trusted this time and not remembered, so nothing is written to known_hosts and every run
          // meets the same question. A desk that once remembered 127.0.0.1:2240 and has since
          // reinstalled its sshd refuses the new key outright; remove that line from
          // %USERPROFILE%\.ssh\known_hosts.
          "locator": "Window#Choice > Button#once",
          "act": "invoke",
          "named": "the server's key is trusted for this connection only"
        },
        {
          "locator": "Text#SessionName",
          "act": "read",
          "reads": "name",
          "expect": "probe",
          "named": "the session bar names the session"
        },
        {
          "locator": "Text#ConnectionState",
          "act": "read",
          "reads": "name",
          "expect": "Connected",
          "named": "and says it is up, in a word"
        },
        {
          "locator": "Button#Forward",
          "act": "read",
          "reads": "name",
          "matches": "^Forward \\d+ → localhost:2240$",
          "named": "the forward the session opened is a chip beside it"
        },
        {
          "locator": "Text#ConnectionStatus",
          "act": "read",
          "reads": "name",
          "matches": "^Connected to 127\\.0\\.0\\.1",
          "named": "and the status bar says where it is connected"
        },
        {
          // QS278 with WW523: the tab is found by the state it publishes, not by its title.
          "locator": "TabItem[status=\"Connected\"]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "the connected tab is found by its state"
        }
      ]
    }
  ]
}
