{
  // QS147. The first case read through the accessibility tree instead of a screenshot.
  //
  // What it asserts is thin, and the thinness is itself the finding: this window is a title bar, the
  // sessions sidebar, the menu bar (QS366) and Home or a terminal (QS272), so there is very little in its tree to read. That is QS46's design
  // working as intended, and it means the cases worth writing here are about the dialogs — which is
  // WW317 in the engine's roadmap, because every one of them is behind a keyboard chord `press`
  // cannot yet spell.
  //
  // What is deliberately NOT here: "there is no toolbar and no status bar". A locator matching
  // nothing has no subject to read, so an expectation of absence is indistinguishable from a broken
  // read — WW318, filed against the engine. `WindowTests` walks the visual tree in-process for that
  // claim and keeps it until there is a word for absence.

  "fixtures": [
    {
      "name": "the window a default installation opens",
      "arguments": [],
      "shareable": true
    },
    {
      // A window asked for a tab, which opens on a local shell whatever startWith says (QS272).
      "name": "a window started on a shell",
      "arguments": ["--tabs", "1"],
      "shareable": true
    },
    {
      // Two tabs, so there is a strip for full screen to take away (QS257); not lent, since the case
      // changes the window's shape.
      "name": "a window of two tabs to fill the screen with",
      "arguments": ["--tabs", "2"],
      "shareable": false
    }
  ],

  "cases": [
    {
      // QS161 named the window for the session it shows, which QS47 had tried and reverted: cmd
      // writes its own full path through OSC within half a second of starting, so the title is a
      // string the machine decides and no case could assert it. `matches` is what makes it
      // assertable — the claim is that the title ENDS in this client's name, whatever the host put
      // in front of it, which is the part of the title this project actually decides.
      "name": "a default installation puts a window named quickshell on the desk",
      "catches": "an application that builds its window correctly and then shows something else, or nothing at all — which every test running inside the process would pass",
      "filed": "QS147",
      "tags": ["smoke", "window"],
      "fixture": "the window a default installation opens",

      "steps": [
        {
          // Selected by kind and read for its name, so the locator does not fix the reading.
          "locator": "TitleBar",
          "act": "read",
          "matches": "quickshell$",
          "reads": "name",
          "named": "the title bar ends in the application's own name"
        }
      ]
    },

    {
      // QS272: a new window opens on Home, which says this client connects to servers and has a way
      // to one on its first screen, and starts no shell until one is asked for. Read through the
      // strip's Home tab and the address box, since Home itself is a Border and publishes nothing.
      "name": "a default installation opens on Home, with a way to a server on it",
      "catches": "a first screen that is a local shell again, or a Home with no address box on it",
      "filed": "QS272",
      "tags": ["smoke", "window", "sessions"],
      "fixture": "the window a default installation opens",

      "steps": [
        {
          "locator": "Button#HomeButton",
          "act": "read",
          "reads": "name",
          "expect": "Home",
          "named": "Home is on the strip"
        },
        {
          "locator": "ComboBox#Address",
          "act": "read",
          "reads": "name",
          "expect": "Address",
          "named": "and the address box is on the first screen"
        }
      ]
    },

    {
      // QS116, and the only check of it that runs against the shipped client rather than against
      // its parts. The terminal is a texture, so there is nothing in this tree that could report a
      // pixel — but the element only exists at all once the pane has been given a buffer to
      // publish, and the pane is given one on the same path that opens the device and starts the
      // loop. An element here is a client that got as far as having a terminal.
      "name": "the terminal in the window is a real one with a buffer behind it",
      "catches": "a client that opens a window and then fails to build a terminal in it — which is exactly what it did before the swapchain, and what it would look like again if the device failed to open",
      "filed": "QS116",
      "tags": ["smoke", "window", "terminal"],
      "fixture": "a window started on a shell",

      "steps": [
        {
          // By class, because the control type is Document and a window may hold more than one
          // thing that is a document. What is read is the name, which the peer answers and the
          // locator does not.
          "locator": "Document[class=\"Terminal\"]",
          "act": "read",
          "expect": "Terminal output",
          "reads": "name",
          "named": "the pane publishes a terminal for a screen reader to find"
        }
      ]
    },

    {
      // QS257. F11 takes the frame, the strip and the bars away and leaves the terminal, and F11 again
      // puts them back. That the window then covers its monitor to the pixel is FullScreenTests': a
      // case cannot yet claim a window covers its monitor (winwright WW548), only that its frame went.
      "name": "F11 fills the screen with the terminal alone, and F11 again gives the window back",
      "catches": "a full screen that keeps its title bar or tab strip over the terminal, or one that F11 cannot leave",
      "filed": "QS257",
      "tags": ["window", "tabs"],
      "fixture": "a window of two tabs to fill the screen with",

      "steps": [
        {
          "locator": "TabItem[order=right]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "the strip is up with the second tab on screen"
        },
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "press",
          "with": "F11",
          "named": "F11 is pressed at the terminal"
        },
        {
          "locator": "TitleBar",
          "act": "read",
          "absent": true,
          "named": "the window has no title bar"
        },
        {
          "locator": "TabItem",
          "act": "read",
          "absent": true,
          "named": "nor a tab strip"
        },
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "read",
          "reads": "name",
          "expect": "Terminal output",
          "named": "and the terminal is still there"
        },
        {
          "locator": "Document[class=\"Terminal\"]",
          "act": "press",
          "with": "F11",
          "named": "F11 is pressed again"
        },
        {
          "locator": "TitleBar",
          "act": "read",
          "reads": "name",
          "matches": "quickshell$",
          "named": "the title bar is back"
        },
        {
          "locator": "TabItem[order=right]",
          "act": "read",
          "reads": "selected",
          "expect": "selected",
          "named": "and the strip, with the same tab on screen"
        }
      ]
    }
  ]
}
