<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HostProbe.WinUI</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: the deployment consequence this option is being judged on is exactly that
         the Windows App Runtime has to be present on the machine. -->
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <ProjectReference Include="..\HostProbe.Core\HostProbe.Core.csproj" />
  </ItemGroup>

</Project>
