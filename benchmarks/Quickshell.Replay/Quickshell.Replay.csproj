<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Quickshell.Replay</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- QS197: the CPU-set table that says which cores are the performance ones is read in place. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\src\Quickshell.Terminal\Quickshell.Terminal.csproj" />
    <ProjectReference Include="..\..\src\Quickshell.Render\Quickshell.Render.csproj" />
  </ItemGroup>

</Project>
